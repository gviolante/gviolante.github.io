---
import { copy } from '../data/content.js';
import Icon from './Icon.astro';
import ExternalLink from './ExternalLink.astro';
const { paper, lang } = Astro.props;
const p = paper[lang], t = copy[lang];
---
<article class="paper-card">
  <div class="paper-index"><div class="conference-logo"><img src={`/assets/images/${paper.logo}`} alt={`${paper.venue} ${paper.year}`} width="180" height="90" loading="lazy" /></div><span class="paper-role">{p.role}</span></div>
  <div class="paper-copy">
    <p class="paper-venue">{paper.year} · {p.venue}</p>
    <h3 lang={paper.publicationLanguage}><ExternalLink href={paper.href}>{paper.title}</ExternalLink></h3>
    <p>{p.summary}</p><p class="paper-authors">{paper.authors}</p>
    <div class="paper-actions">
      <ExternalLink class="text-link" href={paper.href}><Icon name="document" />{t.publication} <span aria-hidden="true">↗</span></ExternalLink>
      <ExternalLink class="paper-doi" href={`https://doi.org/${paper.doi}`}>DOI: {paper.doi} <span aria-hidden="true">↗</span></ExternalLink>
    </div>
  </div>
</article>
