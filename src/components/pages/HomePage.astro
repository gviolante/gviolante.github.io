---
import { copy, homeUrl } from '../../data/content.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Projects from '../sections/Projects.astro';
import Skills from '../sections/Skills.astro';
import Contact from '../sections/Contact.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<BaseLayout lang={lang} title={t.title} description={t.description} alternatePath={homeUrl(lang === 'en' ? 'pt' : 'en')}>
  <Hero lang={lang} /><About lang={lang} /><Projects lang={lang} /><Skills lang={lang} /><Contact lang={lang} />
</BaseLayout>
