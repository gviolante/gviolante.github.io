---
import { copy } from '../../data/content.js';
import { profile } from '../../data/projects.js';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import SectionHeading from '../ui/SectionHeading.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<section id="contact" class="contact-section"><div class="container contact-inner">
  <SectionHeading title={t.contactTitle} intro={t.contactText} />
  <div class="contact-actions" data-reveal>
    <div class="contact-methods">
      <a class="contact-box contact-email" href={`mailto:${profile.email}`}><Icon name="mail" /><span><small>{t.email}</small>{profile.email}</span><span aria-hidden="true">↗</span></a>
      <a class="contact-box contact-phone" href={profile.phoneHref}><Icon name="phone" /><span><small>{t.phone}</small>{profile.phone}</span><span aria-hidden="true">↗</span></a>
      <SocialLinks />
    </div>
    <button class="copy-email" type="button" data-email={profile.email} data-success={t.copied} data-error={t.copyError} hidden><Icon name="copy" />{t.copy}</button>
    <span class="copy-feedback" role="status"></span>
  </div>
</div></section>
