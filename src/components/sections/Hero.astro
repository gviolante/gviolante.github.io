---
import { copy } from '../../data/content.js';
import { profile } from '../../data/projects.js';
import { documentLinks } from '../../data/document-links.js';
import Icon from '../Icon.astro';
import ExternalLink from '../ExternalLink.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<section id="home" class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="green-dot" aria-hidden="true"></span>{t.eyebrow}</p>
    <h1 id="hero-title">Gabriel<br />Violante<span class="hero-period">.</span></h1>
    <p class="hero-description">{t.hero}</p>
    <div class="hero-actions">
      <a class="button button-dark" href={`mailto:${profile.email}`}><Icon name="mail" />{t.email} <span aria-hidden="true">↗</span></a>
      <ExternalLink class="text-link" href={documentLinks.resume[lang]}><Icon name="document" />{t.resume} <span aria-hidden="true">↗</span></ExternalLink>
    </div>
    <p class="hero-location"><Icon name="pin" /> {t.location}</p>
  </div>
  <div class="hero-art">
    <div class="portrait-orbit" aria-hidden="true"></div>
    <span class="art-cross cross-one" aria-hidden="true">+</span><span class="art-cross cross-two" aria-hidden="true">+</span>
    <img src="/assets/images/gabriel-pixel.png" width="1122" height="1402" alt={t.portrait} fetchpriority="high" />
    <span class="art-note" aria-hidden="true">hello, world<span>_</span></span>
  </div>
</section>
