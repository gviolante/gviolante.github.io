---
import { copy } from '../../data/content.js';
import SectionHeading from '../SectionHeading.astro';
import SocialLinks from '../SocialLinks.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<section id="about" class="section about-section">
  <div class="container about-grid">
    <div><SectionHeading label={t.aboutLabel} title={t.aboutTitle} />
      <div class="about-copy">{t.about.map(p => <p>{p}</p>)}</div>
      <SocialLinks />
    </div>
    <aside class="journey" aria-label={t.background}>
      <h3>{t.background}</h3>
      {t.journey.map(([label, title, text]) => <div class="journey-item"><span class="eyebrow">{label}</span><h4>{title}</h4><p>{text}</p></div>)}
    </aside>
  </div>
</section>
