---
import { copy } from '../../data/content.js';
import SectionHeading from '../ui/SectionHeading.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../ui/Icon.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<section id="about" class="section about-section">
  <div class="container about-grid">
    <div><SectionHeading label={t.aboutLabel} title={t.aboutTitle} />
      <div class="about-copy">{t.about.map(p => <p data-reveal>{p}</p>)}</div>
      <SocialLinks />
    </div>
    <aside class="education" aria-label={t.educationTitle}>
      <h3 data-reveal><Icon name="graduation" />{t.educationTitle}</h3>
      <div class="education-cards">
      {t.education.map(item => <article class="education-card" data-reveal>
        <div class="education-card-header">
          <div class:list={['education-logo', { 'education-logo-dcc': item.logo === 'dcc-ufmg.png' }]}><img src={`/assets/images/education/${item.logo}`} alt={item.institution} width={item.logoWidth} height={item.logoHeight} loading="lazy" /></div>
          <dl class="education-average"><dt>{t.overallAverage}</dt><dd>{item.average}<span> / 100</span></dd></dl>
        </div>
        <p class="eyebrow">{item.period}</p><h4>{item.degree}</h4><p class="education-institution">{item.institution}</p>
        <p>{item.description}</p>
        <ul class="education-highlights">{item.highlights.map(text => <li>{text}</li>)}</ul>
      </article>)}
      </div>
    </aside>
  </div>
</section>
