---
import { copy } from '../../data/content.js';
import SectionHeading from '../ui/SectionHeading.astro';
import SocialLinks from '../ui/SocialLinks.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<section id="about" class="section about-section">
  <div class="container about-grid">
    <div><SectionHeading label={t.aboutLabel} title={t.aboutTitle} />
      <div class="about-copy">{t.about.map(p => <p data-reveal>{p}</p>)}</div>
      <SocialLinks />
    </div>
    <aside class="journey" aria-label={t.background}>
      <h3 data-reveal>{t.background}</h3>
      <div class="journey-list"><div class="journey-track" aria-hidden="true"><span class="journey-progress"></span></div>
      {t.journey.map(([label, title, text]) => <div class="journey-item" data-reveal><span class="eyebrow">{label}</span><h4>{title}</h4><p>{text}</p></div>)}
      </div>
    </aside>
  </div>
</section>
