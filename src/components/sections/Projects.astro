---
import { copy } from '../../data/content.js';
import { profile } from '../../data/projects.js';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCollection from '../cards/ProjectCollection.astro';
import ExternalLink from '../ui/ExternalLink.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<section id="projects" class="section container">
  <div class="section-atmosphere" aria-hidden="true"><span></span></div>
  <SectionHeading label={t.projectsLabel} title={t.projectsTitle} intro={t.projectsIntro} />
  <ProjectCollection lang={lang} />
  <ExternalLink class="section-more text-link" href={`${profile.github}?tab=repositories`}>{t.allProjects} <span aria-hidden="true">↗</span></ExternalLink>
</section>
