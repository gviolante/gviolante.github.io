---
import { copy } from '../../data/content.js';
import Icon from '../ui/Icon.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import ProjectVisual from './ProjectVisual.astro';
const { project, lang } = Astro.props;
const p = project[lang], t = copy[lang];
---
<article class="project-card" data-reveal>
  <ExternalLink class={`project-image ${project.slug}`} href={project.href} aria-label={`${project.title} — GitHub`}><ProjectVisual project={project} alt={p.alt} /></ExternalLink>
  <div class="project-card-content">
    <p class="eyebrow">{p.category}</p><h3>{project.title}</h3><p>{p.summary}</p>
    <ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    <ExternalLink class="text-link" href={project.href}><Icon name="github" />{t.github} <span aria-hidden="true">↗</span></ExternalLink>
  </div>
</article>
