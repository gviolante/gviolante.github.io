---
import { copy, homeUrl } from '../data/content.js';
import { projects } from '../data/projects.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
const { lang } = Astro.props;
const t = copy[lang];
---
<BaseLayout lang={lang} title={`${t.nav[2]} — Gabriel Violante`} description={`${t.projectsTitle} — Gabriel Violante`} alternatePath={lang === 'pt' ? '/projects/' : '/projetos/'}>
  <section class="section container page-intro">
    <a class="text-link" href={`${homeUrl(lang)}#projects`}>← {t.back}</a><h1>{t.nav[2]}</h1>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} lang={lang} />)}</div>
  </section>
</BaseLayout>
