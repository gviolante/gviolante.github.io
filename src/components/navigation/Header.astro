---
import { copy, homeUrl, languages } from '../../data/content.js';
import Icon from '../ui/Icon.astro';
import LanguageFlag from './LanguageFlag.astro';
const { lang, alternatePath } = Astro.props;
const t = copy[lang];
const sections = ['home', 'about', 'projects', 'papers', 'skills', 'contact'];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeUrl(lang)} aria-label={`Gabriel Violante — ${t.nav[0]}`}>g<span>v</span>.</a>
    <nav id="site-nav" aria-label={t.navigation}>
      {sections.map((id, i) => <a href={`${homeUrl(lang)}#${id}`}>{t.nav[i]}</a>)}
    </nav>
    <div class="header-controls">
      <details class="language-control">
        <summary class="language-switch" title={`${t.language}: ${t.languageName}`}>
          <span class="sr-only">{t.language}: </span><Icon name="globe" /><span>{t.languageCode}</span><LanguageFlag lang={lang} />
        </summary>
        <div class="theme-options language-options" role="group" aria-label={t.language}>
          <p>{t.language}</p>
          {languages.map(code => {
            const Tag = code === lang ? 'span' : 'a';
            return <Tag class="language-option" href={code === lang ? undefined : alternatePath} data-language={code} lang={copy[code].locale} hreflang={code === lang ? undefined : copy[code].locale} aria-current={code === lang ? 'page' : undefined}><LanguageFlag lang={code} />{copy[code].languageName}<span class="theme-check" aria-hidden="true">✓</span></Tag>;
          })}
        </div>
      </details>
      <details class="theme-control" hidden>
        <summary title={t.theme}><span class="sr-only">{t.theme}</span><Icon name="sun" /><Icon name="moon" /></summary>
        <div class="theme-options" role="group" aria-label={t.theme}>
          <p>{t.theme}</p>
          {['system', 'light', 'dark'].map((theme, i) => <button type="button" data-theme-option={theme} aria-pressed="false"><Icon name={['monitor', 'sun', 'moon'][i]} />{t.themes[i]}<span class="theme-check" aria-hidden="true">✓</span></button>)}
        </div>
      </details>
      <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" hidden><span></span><span></span><span></span></button>
    </div>
    <div class="reading-progress" aria-hidden="true"></div>
  </div>
</header>
